local function getRandomString()
    return "UI_" .. string.gsub(HttpService:GenerateGUID(false), "-", ""):sub(1, 10)
end

local targetGuiParent = localPlayer:FindFirstChildOfClass("PlayerGui") or game:GetService("CoreGui")

local LimbAliases = {
    ["Head"] = {"Head", "Cabeza"},
    ["Torso"] = {"Torso", "UpperTorso", "LowerTorso"},
    ["Left Arm"] = {"Left Arm", "LeftArm", "LeftUpperArm", "LeftHand", "Brazo izquierdo"},
    ["Right Arm"] = {"Right Arm", "RightArm", "RightUpperArm", "RightHand", "Brazo derecho"},
    ["Left Leg"] = {"Left Leg", "LeftLeg", "LeftUpperLeg", "LeftFoot", "Pierna izquierda"},
    ["Right Leg"] = {"Right Leg", "RightLeg", "RightUpperLeg", "RightFoot", "Pierna derecha"},
    ["HumanoidRootPart"] = {"HumanoidRootPart", "RootPart"}
}

local function getPlayerLimb(partName)
    local lowerName = partName:lower()
    for mainLimb, aliases in pairs(LimbAliases) do
        for _, alias in ipairs(aliases) do
            if lowerName == alias:lower() or lowerName:find(alias:lower()) then
                local found = character:FindFirstChild(mainLimb) or character:FindFirstChild(alias)
                if found then return found end
            end
        end
    end
    return character:FindFirstChild("Torso") or rootPart
end

local function findEntityModel(nameQuery)
    local query = nameQuery:lower()
    local charFolder = Workspace:FindFirstChild("Characters")
    
    if charFolder then
        for _, child in ipairs(charFolder:GetChildren()) do
            if child.Name:lower() == query or child.Name:lower():find("^" .. query) then
                return child
            end
        end
        for _, child in ipairs(charFolder:GetChildren()) do
            if child.Name:lower():find(query) then
                return child
            end
        end
    end

    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") and child ~= character and (child.Name:lower() == query or child.Name:lower():find(query)) then
            return child
        end
    end

    return nil
end

local WeaponNames = {
    "ks-23-rif", "ak-74-rif", "ks-23-miniboss", "pkp", "buzzsaw", 
    "saw", "shotgun", "pistol", "rifle", "blade", "sword", 
    "knife", "baton", "riotshieldcollisionbody", "weapon", "gun"
}

local TacticalAllowKeywords = {
    "backpack", "pack", "vest", "pouch", "bag", "rig", "harness", "radio", "belt"
}

local function isWeaponOrTool(item)
    if item:IsA("Tool") or item:IsA("HopperBin") or item:IsA("Accoutrement") then
        return true
    end

    local nameLower = item.Name:lower()

    -- Exclusión de la hacha del Slasher (Handle con textura Dirty o dentro de un brazo)
    if nameLower == "handle" then
        if item:FindFirstChild("Dirty") then
            return true
        end
        local parentName = item.Parent and item.Parent.Name:lower() or ""
        if parentName:find("arm") or parentName:find("brazo") or parentName:find("hand") then
            return true
        end
    end

    -- Exclusiones de Shield, Machete y Chain
    if nameLower == "shield" or nameLower == "machete" or nameLower == "chain" or nameLower == "cover" then
        return true
    end

    for _, allowKw in ipairs(TacticalAllowKeywords) do
        if nameLower:find(allowKw) then
            return false
        end
    end

    for _, kw in ipairs(WeaponNames) do
        if nameLower == kw or nameLower:find(kw) then
            return true
        end
    end

    local parent = item.Parent
    while parent and parent ~= Workspace do
        if parent:IsA("Tool") then return true end
        local parentName = parent.Name:lower()
        if parentName == "shield" or parentName == "machete" or parentName == "chain" then
            return true
        end
        for _, allowKw in ipairs(TacticalAllowKeywords) do
            if parentName:find(allowKw) then return false end
        end
        for _, kw in ipairs(WeaponNames) do
            if parentName == kw or parentName:find(kw) then return true end
        end
        parent = parent.Parent
    end

    return false
end

local function isHeadComponent(partName)
    local lower = partName:lower()
    return lower:find("head") or lower:find("cabeza") or lower:find("helmet") or lower:find("mask") or lower:find("hood") or lower:find("visor") or lower:find("hat") or lower:find("goggle")
end

local function isSkinCoverLayer(part)
    local name = part.Name:lower()
    if name == "torso" or name == "left arm" or name == "right arm" or name == "left leg" or name == "right leg" or name == "upper torso" or name == "lower torso" or name == "brazo derecho" or name == "brazo izquierdo" then
        return true
    end
    if name:find("skin") or name:find("basebody") or name:find("cover") then
        return true
    end
    return false
end

local function preparePlayerBodyAndClothing(targetModel)
    pcall(function()
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Accessory") or child:IsA("Hat") or child:IsA("GraphicTShirt") then
                child:Destroy()
            end
        end

        -- Remover cara automáticamente
        local myHead = character:FindFirstChild("Head") or character:FindFirstChild("Cabeza")
        if myHead then
            myHead.Transparency = 1
            for _, item in ipairs(myHead:GetChildren()) do
                if item:IsA("Decal") or item.Name:lower() == "cara" or item.Name:lower() == "face" then
                    item:Destroy()
                end
            end
        end

        local entShirt = targetModel:FindFirstChildOfClass("Shirt") or targetModel:FindFirstChild("Shirt", true)
        local entPants = targetModel:FindFirstChildOfClass("Pants") or targetModel:FindFirstChild("Pants", true)

        if entShirt then
            local myShirt = character:FindFirstChildOfClass("Shirt") or Instance.new("Shirt", character)
            myShirt.ShirtTemplate = entShirt.ShirtTemplate
        end

        if entPants then
            local myPants = character:FindFirstChildOfClass("Pants") or Instance.new("Pants", character)
            myPants.PantsTemplate = entPants.PantsTemplate
        end

        local bc = character:FindFirstChildOfClass("BodyColors") or Instance.new("BodyColors", character)
        local blackColor = BrickColor.new("Really black")
        bc.HeadColor = blackColor
        bc.TorsoColor = blackColor
        bc.LeftArmColor = blackColor
        bc.RightArmColor = blackColor
        bc.LeftLegColor = blackColor
        bc.RightLegColor = blackColor
    end)
end

