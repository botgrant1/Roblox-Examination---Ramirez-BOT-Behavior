-- APLICAR MORPH
-- ----------------------------------------------------------------------------

local function applyWorkspaceMorph(targetModelName)
    local targetModel = findEntityModel(targetModelName)
    if not targetModel then return false end

    for _, old in ipairs(character:GetChildren()) do
        if old.Name == "RamirezActiveMotorMorph" then
            old:Destroy()
        end
    end

    local morphModel = Instance.new("Model")
    morphModel.Name = "RamirezActiveMotorMorph"
    morphModel.Parent = character

    local appliedCount = 0
    local clonedPartsMap = {}

    preparePlayerBodyAndClothing(targetModel)

    local targetHead = targetModel:FindFirstChild("Head") or targetModel:FindFirstChild("Cabeza") or targetModel.PrimaryPart

    for _, item in ipairs(targetModel:GetDescendants()) do
        if item:IsA("BasePart") and item.Name ~= "HumanoidRootPart" then
            if not isWeaponOrTool(item) and not isSkinCoverLayer(item) and item.Transparency < 0.9 then
                pcall(function()
                    local clonePart = item:Clone()

                    for _, sub in ipairs(clonePart:GetDescendants()) do
                        if sub:IsA("JointInstance") or sub:IsA("Weld") or sub:IsA("WeldConstraint") or sub:IsA("Motor6D") or sub:IsA("Script") then
                            sub:Destroy()
                        elseif sub:IsA("Light") or sub:IsA("BillboardGui") or sub:IsA("SurfaceGui") or sub:IsA("TextLabel") then
                            sub:Destroy()
                        end
                    end

                    clonePart.CanCollide = false
                    clonePart.CanTouch = false
                    clonePart.CanQuery = false
                    clonePart.Massless = true
                    clonePart.Anchored = false
                    
                    clonePart.Parent = morphModel
                    clonedPartsMap[item] = clonePart

                    appliedCount = appliedCount + 1
                end)
            end
        elseif item:IsA("BillboardGui") then
            local lname = item.Name:lower()
            if lname:find("eye") or lname:find("glow") or lname:find("flare") then
                pcall(function()
                    local cloneEffect = item:Clone()
                    local myHead = character:FindFirstChild("Head") or character:FindFirstChild("Cabeza")
                    if myHead then cloneEffect.Parent = myHead end
                end)
            end
        end
    end

    local myHead = character:FindFirstChild("Head") or character:FindFirstChild("Cabeza") or playerHead

    for origItem, clonedPart in pairs(clonedPartsMap) do
        pcall(function()
            if isHeadComponent(origItem.Name) then
                if targetHead then
                    local offset = targetHead.CFrame:ToObjectSpace(origItem.CFrame)
                    clonedPart.CFrame = myHead.CFrame * offset
                else
                    clonedPart.CFrame = myHead.CFrame
                end

                local headWeld = Instance.new("WeldConstraint")
                headWeld.Name = getRandomString()
                headWeld.Part0 = myHead
                headWeld.Part1 = clonedPart
                headWeld.Parent = clonedPart
            end
        end)
    end

    for _, origJoint in ipairs(targetModel:GetDescendants()) do
        if origJoint:IsA("Motor6D") or origJoint:IsA("Weld") then
            pcall(function()
                local p0 = origJoint.Part0
                local p1 = origJoint.Part1

                if p0 and p1 then
                    local clonedP1 = clonedPartsMap[p1]

                    if clonedP1 and not isHeadComponent(p1.Name) then
                        local newJoint = Instance.new("Motor6D")
                        newJoint.Name = getRandomString()
                        
                        local playerPart0 = getPlayerLimb(p0.Name)
                        if p0.Name == "HumanoidRootPart" then
                            playerPart0 = rootPart
                        end

                        newJoint.Part0 = playerPart0
                        newJoint.Part1 = clonedP1
                        newJoint.C0 = origJoint.C0
                        newJoint.C1 = origJoint.C1
                        newJoint.Parent = clonedP1
                    end
                end
            end)
        end
    end

    for origItem, clonedPart in pairs(clonedPartsMap) do
        if not isHeadComponent(origItem.Name) and not clonedPart:FindFirstChildOfClass("Motor6D") and not clonedPart:FindFirstChildOfClass("WeldConstraint") then
            pcall(function()
                local targetLimb = getPlayerLimb(origItem.Name)
                local weld = Instance.new("WeldConstraint")
                weld.Name = getRandomString()
                weld.Part0 = targetLimb
                weld.Part1 = clonedPart
                weld.Parent = clonedPart
            end)
        end
    end

    return appliedCount > 0
end

